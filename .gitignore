# Rust
/target
**/*.rs.bk
/result
/result-*

# Reference clones (inspiration only — not part of this project)
/refs/

# Local config / secrets
.env
auth.json

# Data / runtime
*.db
*.db-wal
*.db-shm
*.sqlite
/data/

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Agent evidence (local only)
/.omo/

# API keys dropped next to the code by hand
*.key

# A models.json at the repository root would shadow ~/.config/navai/models.json for every
# session started from this checkout; models.example.json is the committed example.
/models.json

# Python bytecode
__pycache__/
*.pyc

# Orchestrator progress files (local only)
.slim/deepwork/

# OpenChamber session data (screenshots, local state)
/.openchamber/

# Per-workspace WithNav state of this checkout (flows, intent, agents, charts); the old names are
# still read during 0.7.
/.withnav/
/.navai/
/.navigator/

# Release packages built by scripts/package-vsix.sh
/dist/
