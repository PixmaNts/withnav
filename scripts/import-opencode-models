#!/usr/bin/env python3
"""Build Navai's models.json and auth.json from the OpenCode config.

Reads ~/.config/opencode/opencode.jsonc (or --opencode PATH), takes every
model of every openai-compatible provider, and writes catalog names of the
form <gateway>/<exact upstream id>. No assignments or config.json are written.
Existing catalog metadata and unmanaged providers are preserved. Literal keys
go to auth.json (0600), never to models.json. OmniRoute combo models receive
low/medium/high reasoning_effort variants; manual variants take precedence.

Refresh contract: matching source ids own provider/model identity and supplied
api, supports_tools, supports_parallel_tool_calls (or OpenCode toolcall), and
reasoning_history fields. With --with-windows, supplied limit.context/input/output
refresh context_window/max_input_tokens/max_output_tokens. Otherwise existing
windows remain manual. Missing source fields retain existing values, except
supports_tools/parallel defaults remain source-generated True. Variants and
default_variant always remain manual; unmanaged entries remain unchanged.
Existing fim/systemone token limits remain manual even for matching source ids.

What it imports:
  - Only OpenAI-compatible providers (`npm` is `@ai-sdk/openai-compatible` or
    `@ai-sdk/openai`). Any other provider is skipped with a warning.
  - The same upstream id from two gateways is retained under distinct names.
    Duplicate JSON keys and conflicting legacy catalog models are refused.
  - `apiKey` as a literal goes to auth.json (0600). `apiKey` as `{env:NAME}`
    becomes `"api_key_env": "NAME"` in models.json, nothing is stored for it,
    and a key already stored in auth.json for that provider is REMOVED (Navai
    prefers a stored key over the environment, so it would hide `{env:NAME}`).
    Other providers' entries are kept. Any other `{...}` reference (such as
    `{file:...}`) is refused.
  - A `baseURL` with credentials (`user:pass@`) or a query string with a
    key-like parameter is refused: Navai would write it to models.json.

Everything is checked before anything is written. Each file is written to a
temporary file in the same directory and renamed over the old one, so each
file is replaced atomically. The two files are not replaced together: if the
second replacement fails, the first file has already been updated and the
script says which one was and which was not. A failure before the first
replacement changes nothing.

Usage: import-opencode-models [--config-dir DIR] [--opencode FILE]
                              [--with-windows] [--dry-run] [--self-test]
"""

import argparse
import json
import os
import re
import sys
import tempfile
from pathlib import Path
from urllib.parse import parse_qsl, urlsplit

OPENAI_STYLE_NPM = {"@ai-sdk/openai-compatible", "@ai-sdk/openai"}
KEYLIKE = re.compile(r"key|token|secret|auth|passw|sig|credential", re.I)
ENV_REF = re.compile(r"^\{env:([A-Za-z_][A-Za-z0-9_]*)\}$")


class ImportError_(Exception):
    """A problem the user must fix; nothing has been written."""

def unique_object(pairs):
    """Reject duplicate JSON keys without exposing their potentially secret values."""
    result = {}
    for key, value in pairs:
        if key in result:
            raise ImportError_("duplicate JSON object key (source must use unique names)")
        result[key] = value
    return result


def load_json(text, jsonc=False):
    return json.loads(strip_jsonc(text) if jsonc else text,
                      object_pairs_hook=unique_object)


def validate_provider(pname, provider):
    if not isinstance(provider, dict) or not isinstance(provider.get("base_url"), str):
        raise ImportError_("catalog provider requires an object and base_url string")

    def check_fields(fields):
        for field, value in fields.items():
            if field != "api_key_env" and KEYLIKE.search(field):
                raise ImportError_("catalog provider contains an inline credential field")
            if isinstance(value, dict):
                check_fields(value)
    check_fields(provider)
    return {**provider, "base_url": check_base_url(pname, provider["base_url"])}


def provider_identity(provider):
    # Conservatively include unknown routing fields, headers and env selection.
    return {key: value for key, value in provider.items()
            if key not in ("catalog_format", "connect_timeout_ms", "request_timeout_ms")}


def check_provider_changes(imported, existing, keys, env_providers):
    for pname, old in existing.get("providers", {}).items():
        old = validate_provider(pname, old)
        if pname in imported and provider_identity(old) != provider_identity(imported[pname]):
            if pname not in keys and pname not in env_providers:
                raise ImportError_("provider identity changed; an explicit literal apiKey "
                                   "or {env:NAME} reference is required")


def merge_catalog(providers, models, existing):
    """Normalize aliases and apply the source-managed refresh contract above."""
    if not isinstance(existing, dict):
        raise ImportError_("existing models.json is not a JSON object")
    old_providers = existing.get("providers", {})
    old_models = existing.get("models", {})
    if not isinstance(old_providers, dict) or not isinstance(old_models, dict):
        raise ImportError_("existing catalog providers/models must be objects")
    old_providers = {name: validate_provider(name, entry)
                     for name, entry in old_providers.items()}
    preserved = {}
    for entry in old_models.values():
        if not isinstance(entry, dict):
            raise ImportError_("existing catalog model must be an object")
        gateway, mid = entry.get("provider"), entry.get("model")
        if not isinstance(gateway, str) or not gateway or not isinstance(mid, str) or not mid:
            raise ImportError_("existing catalog model requires nonempty provider and model")
        name = f"{gateway}/{mid}"
        if gateway not in providers and gateway not in old_providers:
            raise ImportError_(f"catalog model '{name}' has an undeclared provider")
        if name in preserved and preserved[name] != entry:
            raise ImportError_(f"conflicting metadata for qualified model '{name}'")
        preserved[name] = dict(entry)
    providers = {**old_providers, **providers}
    for name, manual in preserved.items():
        generated = models.get(name, {})
        entry = {**generated, **manual}
        for field in ("provider", "model", "api", "supports_tools",
                      "supports_parallel_tool_calls", "reasoning_history",
                      "context_window", "max_input_tokens", "max_output_tokens"):
            if field in generated:
                if (manual.get("api") in ("systemone", "fim")
                        and field in ("context_window", "max_input_tokens", "max_output_tokens")):
                    continue  # Dedicated API limits are manual, not chat catalog limits.
                entry[field] = generated[field]
        if "variants" in generated or "variants" in manual:
            variants = manual.get("variants", {})
            if not isinstance(variants, dict):
                raise ImportError_(f"catalog model '{name}' variants must be an object")
            entry["variants"] = {**generated.get("variants", {}), **variants}
        models[name] = entry
    # Preserved combo entries also receive the standard variants.
    for entry in models.values():
        if entry["provider"] == "omniroute" and entry["model"].startswith("combo/"):
            variants = entry.get("variants", {})
            if not isinstance(variants, dict):
                raise ImportError_("combo variants must be an object")
            entry["variants"] = {
                **{tier: {"reasoning_effort": tier} for tier in ("low", "medium", "high")},
                **variants,
            }
    return providers, dict(sorted(models.items()))


def _skip_gap(text: str, i: int) -> int:
    """Index of the next character after whitespace and comments."""
    while i < len(text):
        if text[i].isspace():
            i += 1
        elif text.startswith("//", i):
            while i < len(text) and text[i] != "\n":
                i += 1
        elif text.startswith("/*", i):
            end = text.find("*/", i + 2)
            if end < 0:
                raise ImportError_("unterminated /* comment in the OpenCode config")
            i = end + 2
        else:
            break
    return i


def strip_jsonc(text: str) -> str:
    """Drop comments and trailing commas, outside strings only.

    >>> strip_jsonc('{"a": 1, // note\\n "b": [1, 2,], /* x */ }')
    '{"a": 1,  \\n "b": [1, 2]   }'
    >>> strip_jsonc('{"x": "keep,]", "y": "//no", "z": "/*no*/",}')
    '{"x": "keep,]", "y": "//no", "z": "/*no*/"}'
    >>> strip_jsonc('{"q": "a\\\\"b,}"}')
    '{"q": "a\\\\"b,}"}'
    """
    out, i, in_str = [], 0, False
    while i < len(text):
        c = text[i]
        if in_str:
            out.append(c)
            if c == "\\" and i + 1 < len(text):
                out.append(text[i + 1])
                i += 1
            elif c == '"':
                in_str = False
        elif c == '"':
            in_str = True
            out.append(c)
        elif text.startswith("//", i):
            out.append(" ")
            while i < len(text) and text[i] != "\n":
                i += 1
            continue
        elif text.startswith("/*", i):
            out.append(" ")
            end = text.find("*/", i + 2)
            if end < 0:
                raise ImportError_("unterminated /* comment in the OpenCode config")
            i = end + 2
            continue
        elif c == ",":
            j = _skip_gap(text, i + 1)
            if j < len(text) and text[j] in "}]":
                i += 1  # a trailing comma: drop it
                continue
            out.append(c)
        else:
            out.append(c)
        i += 1
    return "".join(out)


def check_base_url(pname: str, base: str) -> str:
    parts = urlsplit(base)
    if parts.scheme not in ("http", "https") or not parts.hostname:
        raise ImportError_(f"provider '{pname}': baseURL is not an http(s) URL")
    if parts.username is not None or parts.password is not None:
        raise ImportError_(
            f"provider '{pname}': baseURL carries credentials; put the key in apiKey instead")
    for name, _ in parse_qsl(parts.query, keep_blank_values=True):
        if KEYLIKE.search(name):
            raise ImportError_(
                f"provider '{pname}': baseURL has a key-like query parameter; "
                "Navai would store it in models.json")
    return base.rstrip("/")


def read_api_key(pname: str, raw):
    """Returns (literal key or None, env var name or None)."""
    if raw is None or raw == "":
        return None, None
    if not isinstance(raw, str):
        raise ImportError_(f"provider '{pname}': apiKey is not a string")
    m = ENV_REF.match(raw)
    if m:
        return None, m.group(1)
    if "{" in raw and "}" in raw and re.search(r"\{[a-z]+:", raw):
        raise ImportError_(
            f"provider '{pname}': apiKey contains an unsupported reference; only "
            "{env:NAME} is supported. Put the key in an environment variable, or write the "
            "literal key.")
    return raw, None


def convert(oc: dict, with_windows: bool, warn):
    """OpenCode config -> (providers, models, keys, env_providers): `keys` are the
    literal keys to store, `env_providers` the providers whose key is an
    `{env:NAME}` reference. Raises ImportError_."""
    if not isinstance(oc, dict) or not isinstance(oc.get("provider", {}), dict):
        raise ImportError_("OpenCode config and provider map must be objects")
    providers, models, keys, env_providers = {}, {}, {}, set()
    for pname, p in oc.get("provider", {}).items():
        if not isinstance(pname, str) or not pname or not isinstance(p, dict):
            raise ImportError_("provider requires a nonempty name and an object")
        opts = p.get("options", {})
        if not isinstance(opts, dict):
            raise ImportError_(f"provider '{pname}': options must be an object")
        base = opts.get("baseURL")
        if not base:
            continue
        if not isinstance(base, str):
            raise ImportError_(f"provider '{pname}': baseURL must be a string")
        if p.get("npm") not in OPENAI_STYLE_NPM:
            warn(f"skipped provider '{pname}': npm {p.get('npm')!r} is not OpenAI-compatible")
            continue
        key, env = read_api_key(pname, opts.get("apiKey"))
        providers[pname] = {
            "base_url": check_base_url(pname, base),
            "api_key_env": env or re.sub(r"[^A-Z0-9]", "_", pname.upper()) + "_API_KEY",
        }
        if key:
            keys[pname] = key
        if env:
            env_providers.add(pname)
        source_models = p.get("models", {})
        if not isinstance(source_models, dict):
            raise ImportError_(f"provider '{pname}': models must be an object")
        for mid, m in source_models.items():
            if not isinstance(mid, str) or not mid or not isinstance(m, dict):
                raise ImportError_(f"provider '{pname}': model requires a nonempty id and an object")
            name = f"{pname}/{mid}"
            if name in models:
                raise ImportError_(f"duplicate qualified model '{name}'")
            lim = m.get("limit", {})
            if not isinstance(lim, dict):
                raise ImportError_(f"model '{name}': limit must be an object")
            entry = {"provider": pname, "model": mid, "supports_tools": True,
                     "supports_parallel_tool_calls": True}
            for field in ("api", "supports_tools", "supports_parallel_tool_calls", "reasoning_history"):
                if field in m:
                    entry[field] = m[field]
            if "toolcall" in m and "supports_tools" not in m:
                entry["supports_tools"] = m["toolcall"]
            if with_windows:
                for source, target in (("context", "context_window"),
                                       ("input", "max_input_tokens"),
                                       ("output", "max_output_tokens")):
                    if lim.get(source):
                        entry[target] = int(lim[source])
            models[name] = entry
    if "omniroute" not in providers:
        raise ImportError_("no usable omniroute provider in the OpenCode config")
    providers["omniroute"]["catalog_format"] = "omniroute"
    providers, models = merge_catalog(providers, models, {})
    return providers, models, keys, env_providers


def stage(path: Path, text: str, mode: int) -> Path:
    """Writes `text` to a new, uniquely named file beside `path` (created
    exclusively, mode set before any content is written) and returns it."""
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.", suffix=".tmp")
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "w") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
    except BaseException:
        os.unlink(tmp)
        raise
    return Path(tmp)


def sync_dir(d: Path) -> None:
    fd = os.open(d, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def update_auth(auth: dict, keys: dict, env_providers: set):
    """The new auth.json content and the providers whose stored key was removed.

    A provider whose key is an `{env:NAME}` reference loses its stored entry:
    Navai prefers a stored key over the environment.
    """
    new = {k: v for k, v in auth.items() if k not in env_providers}
    removed = sorted(k for k in env_providers if k in auth)
    for k, v in keys.items():
        new[k] = {"api_key": v}
    return new, removed


class PartialWrite(Exception):
    """A replacement failed after an earlier one succeeded."""


def write_files(d: Path, files: dict) -> None:
    """Stage every file, then rename them one by one. Each rename is atomic;
    the set is not. A failure while staging, or in the first rename, changes
    nothing. A later failure raises PartialWrite saying what was replaced."""
    d.mkdir(parents=True, exist_ok=True)
    staged = {}
    replaced = []
    try:
        for name, (text, mode) in files.items():
            staged[name] = stage(d / name, text, mode)
        for name in list(staged):
            try:
                os.replace(staged[name], d / name)
            except OSError as e:
                if replaced:
                    left = [n for n in files if n not in replaced]
                    raise PartialWrite(
                        f"replaced {', '.join(replaced)}; NOT replaced: {', '.join(left)} ({e})")
                raise
            del staged[name]
            replaced.append(name)
    finally:
        for tmp in staged.values():
            tmp.unlink(missing_ok=True)
    try:
        sync_dir(d)
    except OSError as e:
        raise PartialWrite(
            f"replaced {', '.join(replaced)}, but syncing the directory failed ({e}); "
            "the files are in place and may not be durable yet")


def self_test() -> int:
    import doctest
    failed = doctest.testmod(sys.modules[__name__]).failed
    errors = []

    def check(cond, what):
        if not cond:
            errors.append(what)

    check(json.loads(strip_jsonc('{"x":"keep,]"}')) == {"x": "keep,]"}, "comma in a string")
    check(json.loads(strip_jsonc('{"u":"http://h/p", "a": [1,],}')) == {"u": "http://h/p", "a": [1]},
          "// inside a string, trailing commas")
    check(json.loads(strip_jsonc('{"a": 1, /* c */ }')) == {"a": 1}, "comma before a comment")
    for bad in ("http://u:p@h/v1", "http://h/v1?api_key=abc", "ftp://h/v1"):
        try:
            check_base_url("p", bad)
            errors.append(f"accepted {bad}")
        except ImportError_:
            pass
    check(check_base_url("p", "http://h:1/v1/") == "http://h:1/v1", "clean url")
    check(read_api_key("p", "{env:MY_KEY}") == (None, "MY_KEY"), "env reference")
    check(read_api_key("p", "sk-123") == ("sk-123", None), "literal key")
    try:
        read_api_key("p", "{file:~/k}")
        errors.append("accepted a file reference")
    except ImportError_:
        pass
    oc = {"provider": {
        "omniroute": {"npm": "@ai-sdk/openai-compatible", "options": {
            "baseURL": "http://h/v1", "apiKey": "{env:OR_KEY}"}, "models": {"m": {}}},
        "other": {"npm": "@ai-sdk/openai-compatible", "options": {"baseURL": "http://o/v1"},
                  "models": {"m": {}, "n": {}}},
        "anthropic": {"npm": "@ai-sdk/anthropic", "options": {"baseURL": "http://a/v1"},
                      "models": {"c": {}}}}}
    warnings = []
    providers, models, keys, env_providers = convert(oc, False, warnings.append)
    check(keys == {} and providers["omniroute"]["api_key_env"] == "OR_KEY", "env key not stored")
    check(env_providers == {"omniroute"}, "env provider reported")
    auth = {"omniroute": {"api_key": "old"}, "unrelated": {"api_key": "x"}}
    check(update_auth(auth, keys, env_providers)[0] == {"unrelated": {"api_key": "x"}},
          "a stored key is removed for an env provider, others kept")
    check("omniroute/m" in models and "other/m" in models and "other/n" in models,
          "distinct gateways retained")
    check("anthropic/c" not in models and len(warnings) == 1, "skips and warns")
    with tempfile.TemporaryDirectory() as tmpd:
        d = Path(tmpd)
        (d / "models.json").write_text("old")
        real, calls = os.replace, []

        def flaky(src, dst):
            calls.append(dst)
            if len(calls) == 2:
                raise OSError("disk full")
            return real(src, dst)

        os.replace = flaky
        try:
            write_files(d, {"models.json": ("new", 0o644), "auth.json": ("{}", 0o600)})
            errors.append("a failed second replacement was not reported")
        except PartialWrite as e:
            check("replaced models.json" in str(e) and "NOT replaced: auth.json" in str(e),
                  "partial failure names both files")
        finally:
            os.replace = real
        check((d / "models.json").read_text() == "new" and not (d / "auth.json").exists(),
              "first file replaced, second not")
        check(sorted(x.name for x in d.iterdir()) == ["models.json"], "no temp files left")
    print("self-test: ok" if not (errors or failed) else f"self-test FAILED: {errors}")
    return 1 if (errors or failed) else 0


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--config-dir", default=os.path.expanduser("~/.config/navai"))
    ap.add_argument("--opencode", default=os.path.expanduser("~/.config/opencode/opencode.jsonc"))
    ap.add_argument("--with-windows", action="store_true",
                    help="copy context_window from the OpenCode config instead of letting "
                         "Navai discover it")
    ap.add_argument("--dry-run", action="store_true",
                    help="print a summary and write nothing")
    ap.add_argument("--self-test", action="store_true", help="run the built-in tests and exit")
    args = ap.parse_args()
    if args.self_test:
        return self_test()

    def warn(msg: str) -> None:
        print(f"warning: {msg}", file=sys.stderr)

    # Validate everything first: nothing is written until all of it is sound.
    try:
        try:
            oc = load_json(Path(args.opencode).read_text(), jsonc=True)
        except ValueError as e:
            raise ImportError_(f"{args.opencode} is not valid JSON/JSONC ({e})")
        providers, models, keys, env_providers = convert(oc, args.with_windows, warn)
        d = Path(args.config_dir)
        catalog_path = d / "models.json"
        if catalog_path.exists():
            existing = load_json(catalog_path.read_text())
            # Validate shape and retained providers before checking identity/auth.
            imported = providers
            providers, models = merge_catalog(providers, models, existing)
            check_provider_changes(imported, existing, keys, env_providers)
        auth_path = d / "auth.json"
        auth = {}
        if auth_path.exists():
            try:
                auth = load_json(auth_path.read_text())
            except ValueError as e:
                raise ImportError_(f"{auth_path} is not valid JSON ({e}); fix or remove it")
            if not isinstance(auth, dict):
                raise ImportError_(f"{auth_path} is not a JSON object")
    except (ImportError_, OSError, ValueError) as e:
        print(f"error: {e}", file=sys.stderr)
        return 1
    old_auth = auth
    auth, removed = update_auth(old_auth, keys, env_providers)
    if args.dry_run:
        print(f"{len(models)} models, providers {sorted(providers)}, keys {sorted(keys)}"
              + (f", stored keys that would be removed {removed}" if removed else ""))
        return 0
    cfg = {"providers": providers, "models": models}
    files = {"models.json": (json.dumps(cfg, indent=2) + "\n", 0o644)}
    if auth != old_auth or (keys and not auth_path.exists()):
        files["auth.json"] = (json.dumps(auth, indent=2) + "\n", 0o600)
    try:
        write_files(d, files)
    except PartialWrite as e:
        print(f"error: {e}", file=sys.stderr)
        return 1
    except OSError as e:
        print(f"error: {e}; nothing was replaced", file=sys.stderr)
        return 1
    print(f"wrote {d/'models.json'} ({len(models)} models)"
          + (f" and {auth_path} (keys stored: {sorted(keys)})" if "auth.json" in files else ""))
    if removed:
        print(f"removed the stored key of {removed} from {auth_path}: its apiKey is an "
              "{env:NAME} reference, and Navai prefers a stored key over the environment")
    return 0


if __name__ == "__main__":
    sys.exit(main())
