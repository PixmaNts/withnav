{
  "name": "navai",
  "displayName": "Navai",
  "description": "Pair-programming navigator: a language server watches your edits and offers short end-of-line remarks.",
  "version": "0.6.0",
  "publisher": "pixmants",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "navai",
          "title": "Navai",
          "icon": "media/navai.svg"
        }
      ]
    },
    "views": {
      "navai": [
        {
          "id": "navai.chat",
          "name": "Cognition",
          "type": "webview"
        }
      ]
    },
    "commands": [
      { "command": "navai.toggleBypassPermissions", "title": "Navai: Toggle Bypass Permissions" },
      {
        "command": "navai.openSettings",
        "title": "Open Settings",
        "category": "Navai",
        "icon": "$(settings-gear)"
      },
      {
        "command": "navai.focusChat",
        "title": "Focus Cognition Chat",
        "category": "Navai"
      },
      {
        "command": "navai.markUseful",
        "title": "Mark Last Remark as Useful",
        "category": "Navai"
      },
      {
        "command": "navai.markNoise",
        "title": "Mark Last Remark as Noise",
        "category": "Navai"
      },
      {
        "command": "navai.dismiss",
        "title": "Dismiss Current Remark",
        "category": "Navai"
      },
      {
        "command": "navai.setIntent",
        "title": "Set Current Intent",
        "category": "Navai"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "navai.openSettings",
          "when": "view == navai.chat",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "navai.markUseful",
        "key": "ctrl+alt+y",
        "when": "navai.remarkVisible"
      },
      {
        "command": "navai.markNoise",
        "key": "ctrl+alt+n",
        "when": "navai.remarkVisible"
      },
      {
        "command": "navai.dismiss",
        "key": "ctrl+alt+d",
        "when": "navai.remarkVisible"
      }
    ],
    "configuration": {
      "title": "Navai",
      "properties": {
        "navai.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the navigator and keep its language server running."
        },
        "navai.serverPath": {
          "type": "string",
          "default": "navai-lsp",
          "description": "Path to the navai-lsp server binary (absolute path, or a command found on PATH)."
        },
        "navai.idleMs": {
          "type": "integer",
          "default": 3000,
          "minimum": 0,
          "description": "Idle delay after the last edit before the navigator may speak."
        },
        "navai.minChangedLines": {
          "type": "integer",
          "default": 3,
          "minimum": 0,
          "description": "Minimum number of changed lines since the last remark for the navigator to consider speaking."
        },
        "navai.cooldownMs": {
          "type": "integer",
          "default": 20000,
          "minimum": 0,
          "description": "Minimum delay between two remarks on the same file."
        },
        "navai.reflex.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline-completion suggestions from the reflex layer."
        }
      }
    }
  },
  "scripts": {
    "pretest": "npm run compile",
    "test": "node test-build.mjs && node --test tests/*.test.cjs",
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p tsconfig.json && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p tsconfig.json",
    "package": "vsce package --allow-missing-repository",
    "package:dry-run": "vsce ls"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.0"
  }
}
